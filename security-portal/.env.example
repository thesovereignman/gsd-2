# automatesecurity.com — Security Portal Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.

# ─── Portal Authentication (REQUIRED) ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=

# Generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
PORTAL_ADMIN_PASSWORD_HASH=

# Set to "true" ONLY for local HTTP dev previews. Never set in production (use HTTPS).
PORTAL_INSECURE_COOKIES=

# ─── BestDefense.io ────────────────────────────────────────────────────────────
BESTDEFENSE_API_KEY=
BESTDEFENSE_BASE_URL=https://app.bestdefense.io/api

# ─── Fireraven.ai ──────────────────────────────────────────────────────────────
FIRERAVEN_CLIENT_ID=
FIRERAVEN_API_KEY=
FIRERAVEN_BASE_URL=https://api.fireraven.ai

# If BESTDEFENSE_API_KEY or FIRERAVEN_API_KEY are blank, mock data is used automatically.
