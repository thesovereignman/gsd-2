---
import Header from './Header.astro';

interface Props {
  title: string;
  bdState?: import('../../lib/shield.js').ShieldState;
  frState?: import('../../lib/shield.js').ShieldState;
}

const { title, bdState = 'secure', frState = 'secure' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — AutomateSecurity</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-page min-h-screen font-sans text-[#374151]">
  <Header bdState={bdState} frState={frState} currentPath={currentPath} />
  <main>
    <slot />
  </main>
  <footer class="border-t border-[#D1D9E0] py-6 px-8 mt-16">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <p class="text-xs font-mono text-[#6B7280] tracking-wide uppercase">
        © AutomateSecurity {new Date().getFullYear()} · All rights reserved
      </p>
      <p class="text-xs font-mono text-[#6B7280]">
        Powered by BestDefense.io + Fireraven.ai
      </p>
    </div>
  </footer>
</body>
</html>
