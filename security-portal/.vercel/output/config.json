{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/alerts/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bestdefense/compliance/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bestdefense/findings/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bestdefense/scans/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bestdefense/test-connection/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/fireraven/events/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/fireraven/status/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/fireraven/test-connection/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}